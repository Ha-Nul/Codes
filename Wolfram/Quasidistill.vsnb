  {
   "kind": 2,
   "value": "sigmaplus = (1/3)* (makesig[1,2]+makesig[2,3]+makesig[3,1])\nsigmaminus = (1/3)* (makesig[2,1]+makesig[3,2]+makesig[1,3])",
   "languageId": "wolfram",
