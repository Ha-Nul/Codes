  {
   "kind": 2,
   "value": "makeent[x_, y_] := \n(   Module[{basis, firstouter, flatX, secondouter, flatY, thirdouter},\n    basis = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};\n    firstouter = Outer[Times, basis[[x]], basis[[x]]];\n    flatX = Flatten[firstouter];\n    secondouter = Outer[Times, basis[[y]], basis[[y]]];\n    flatY = Flatten[secondouter];\n    thirdouter = Outer[Times, flatX, flatY];\n    thirdouter\n]\n)\n",
   "languageId": "wolfram",
   "outputs": [],
