  {
   "kind": 2,
   "value": "makesig[x_, y_] := \n(\n    Module[{basis, firstouter, flat, secondouter},\n    basis = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};\n    firstouter = Outer[Times, basis[[x]], basis[[y]]];\n    flat = Flatten[firstouter];\n    secondouter = Outer[Times, flat, flat];\n    secondouter]\n)\n",
   "languageId": "wolfram",
   "outputs": [],
