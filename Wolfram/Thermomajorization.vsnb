  {
   "kind": 2,
   "value": "k = 1; gamma = 1; sigma0 = 1;\n\nradii[x_,y_] := Sqrt[x^2 + y^2];\n\nmeant[d_,t_] := Exp[-(k/gamma) t];\nvart[d_,t_] := (sigma0^2 - d/k) Exp[-2(k/gamma)t] + d/k;\n\n(* 시간 t에서의 분포 함수 rho(q, t) *)\nrhot[q_, t_,d_] := 1/Sqrt[2 Pi vart[d,t]] Exp[-(q - meant[d,t])^2 / (2 vart[d,t])];\n\nPlot3D[rhot[radii[x, y],0.01,1], {x, -2, 2}, {y, -2, 2},\n PlotRange -> {{-2, 2}, {-2, 2}, {0, All}},\n PlotLabel -> \"Near-Infinite Range Diffusion\",\n AxesLabel -> {\"x\", \"y\", \"delta\"},\n ColorFunction -> \"Rainbow\",\n ImageSize -> {800, 600},\n PlotPoints -> 120,\n BoxRatios -> {1, 1, 0.5}\n]\n",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:933.6px;height:700.0px;\" aspect-ratio=\"0.749786\" tabIndex=\"-1\"><img src=\"data:image/png;base64,\" /></wgraph></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "5ba79fbf-facd-484d-832a-f646a67cc929"
    }
   ],
   "metadata": {},
   "executionSummary": {
