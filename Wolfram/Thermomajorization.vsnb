       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:524.8px;height:284.8px;\" aspect-ratio=\"0.542683\" tabIndex=\"-1\"><img src=\"data:image/png;base64,\" /></wgraph></div>",
       "mime": "x-application/wolfram-language-html"
