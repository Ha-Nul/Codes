{
 "cells": [
  {
   "kind": 2,
   "value": "ddelta[diff_,t_,r_] := Exp[(-r^2)/(4 * diff * t)]/(diff * Pi * 4)^(3/2);\nradii[x_,y_] := Sqrt[x^2 + y^2];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Plot3D[ddelta[1, 1, radii[x, y]], {x, -20, 20}, {y, -20, 20},\n PlotRange -> {{-20, 20}, {-20, 20}, {0, All}},\n PlotLabel -> \"Near-Infinite Range Diffusion\",\n AxesLabel -> {\"x\", \"y\", \"delta\"},\n ColorFunction -> \"Rainbow\",\n ImageSize -> {800, 600},\n PlotPoints -> 120,\n BoxRatios -> {1, 1, 0.5}\n]\n",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "var = 0.1;\nbeta = 1;\nk = 1;\n\npot[q_] := 0.5 * k * q/2;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "rhoinit[q_] := 1/(Sqrt[2*Pi] * var) Exp[-q^2/(2 * var^2)]\nZ = NIntergrate[Exp[beta * pot[q]],{q,-Infinity,Infinity}];\n\nrhot[q_] := Exp[-beta pot[q]]/Z;\n\nFeq = -kB T Log[Z];\nSRel[t_] := NIntegrate[ddelta[q, t] (Log[ddelta[q, t]] - Log[rhot[q]]), {q, -Infinity, Infinity}];\nFinfo[t_] := Feq + kB T SRel[t];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "k = 1; gamma = 1; sigma0 = 1;\n\nmeant[d_,t_] := Exp[-(k/gamma) t];\nvart[d_,t_] := (sigma0^2 - d/k) Exp[-2(k/gamma)t] + d/k;\n\n(* 시간 t에서의 분포 함수 rho(q, t) *)\nrhot[q_, t_,d_] := 1/Sqrt[2 Pi vart[d,t]] Exp[-(q - meant[d,t])^2 / (2 vart[t])];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1751440358923,
     "endTime": 1751440358927
    },
    "executionOrder": 204,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "Plot[{meant[1, t], vart[1, t]}, {t, 0, 5},\n PlotLabel -> \"Functions at d=1\",\n AxesLabel -> {\"t\", \"value\"},\n PlotLegends -> {\"mean_t\", \"var_t\"},\n PlotStyle -> {Blue, Red}\n]",
   "languageId": "wolfram",
   "outputs": [
