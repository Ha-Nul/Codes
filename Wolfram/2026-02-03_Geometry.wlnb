  },
  {
   "kind": 2,
   "value": "ParametricPlot3D[{x[t],p[t],x[t]^2 + p[t]^2/(2*mass)}, {t,-0,0.01},\r\n    AxesLabel -> {\"Position (x)\", \"Momentum (p)\",\"Energy\"},\r\n    PlotStyle -> {AbsoluteThickness[0.5],Red},\r\n    Mesh -> 9,\r\n    MeshStyle -> {PointSize[Large], Blue},\r\n    BoxRatios -> {2,1,1}\r\n]",
