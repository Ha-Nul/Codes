isplayFunction -> Identity, DisplayFunction -> Identity, Ticks -> {Automatic, Automatic, Automatic}, FaceGrids -> None, DisplayFunction -> Identity, Axes -> True, AxesLabel -> {HoldForm[\"x\"], HoldForm[\"p\"], HoldForm[\"Energy\"]}, AxesOrigin -> {Automatic, Automatic, Automatic}, BoxRatios -> {1, 1, 0.4}, DisplayFunction :> Identity, FaceGridsStyle -> Automatic, Lighting -> \"Neutral\", Method -> {\"DefaultBoundaryStyle\" -> Directive[GrayLevel[0.3]], \"DefaultGraphicsInteraction\" -> {\"Version\" -> 1.2, \"TrackMousePosition\" -> {True, False}, \"Effects\" -> {\"Highlight\" -> {\"ratio\" -> 2}, \"HighlightPoint\" -> {\"ratio\" -> 2}, \"Droplines\" -> {\"freeformCursorMode\" -> True, \"placement\" -> {\"x\" -> \"All\", \"y\" -> \"None\"}}}}, \"RotationControl\" -> \"Globe\"}, PlotRange -> {{0, 7}, {0, 7}, {0., 97.9999860000005}}, PlotRangePadding -> {Scaled[0.02], Scaled[0.02], Scaled[0.02]}, Ticks -> {Automatic, Automatic, Automatic}}], Placed[BarLegend[{\"LightTemperatureMap\", {0, 40}}, LabelStyle -> {}, LegendLabel -> \"Energy\", LegendLayout -> \"Column\", LegendMarkerSize -> 150, Charting`AxisLabel -> None, Charting`TickSide -> Right, ColorFunctionScaling -> True], After, Identity]]",
