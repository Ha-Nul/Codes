   ],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(* 예시를 위해 x(t), p(t), mass를 정의합니다. 실제 함수로 대체하여 사용하세요. *)\r\nx[t_] := Sin[5*t];\r\np[t_] := Cos[5*t];\r\nmass = 1;\r\n\r\n(* 1. 시간에 따라 색이 변하는 연속적인 선 그래프와 컬러바를 생성합니다. *)\r\nlinePlot = ParametricPlot3D[{x[t], p[t], x[t]^2 + p[t]^2/(2*mass)}, {t, 0, 1.5},\r\n    PlotStyle -> AbsoluteThickness[2],\r\n    ColorFunction -> Function[{x, y, z, tParam}, ColorData[\"Rainbow\"][tParam]], (* t 값(0~1.5)에 따라 색상 변경 *)\r\n    ColorFunctionScaling -> True, (* t의 범위를 0~1로 자동 조정하여 색상 함수에 적용 *)\r\n    PlotLegends -> BarLegend[{\"Rainbow\", {0, 1.5}}, LegendLabel -> \"Time (t)\"], (* 컬러바 추가 *)\r\n    AxesLabel -> {\"Position (x)\", \"Momentum (p)\", \"Energy\"},\r\n    BoxRatios -> {2, 1, 1}\r\n];\r\n\r\n(* 2. 시간에 따라 색이 변하는 10개의 점 그래프를 생성합니다. *)\r\npointPlot = ListPointPlot3D[\r\n    Table[{x[t], p[t], x[t]^2 + p[t]^2/(2*mass)}, {t, 0, 1.5, 1.5/9}],\r\n    (* 각 점의 스타일(크기, 색상)을 시간 t에 맞춰 개별적으로 지정합니다. *)\r\n    PlotStyle -> Table[Directive[PointSize[Large], ColorData[\"Rainbow\"][t/1.5]], {t, 0, 1.5, 1.5/9}],\r\n    BoxRatios -> {2, 1, 1}\r\n];\r\n\r\n(* 3. Show 함수를 사용해 두 그래프를 합칩니다. *)\r\nShow[linePlot, pointPlot, PlotLabel -> \"Phase Space Trajectory\"]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
