  },
  {
   "kind": 1,
   "value": "Make a functional",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "mass = 1;\r\n\r\nx[t_] := 0.5 * 10 * t^2\r\np[t_] := mass * 10 * t",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "x1[t_] := 0.5 * 10 * Cos[t]\r\nx2[t_] := -0.2 * 10 * Sin[t]\r\nx3[t_] := 0.3 * 10 * Cos[t]\r\n\r\np1[t_] := -mass * 5 * Sin[t]\r\np2[t_] := -mass * 2 * Cos[t]\r\np3[t_] := -mass * 3 * Sin[t]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "x[t_] := Sqrt[x1[t]^2 + x2[t]^2 + x3[t]^2]\r\np[t_] := Sqrt[p1[t]^2 + p2[t]^2 + p3[t]^2]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "x[1]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
